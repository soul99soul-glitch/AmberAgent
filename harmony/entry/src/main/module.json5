{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // E13:DATA_TRANSFER 长时任务类型声明(生成中切后台保活;
        //   声明是申请前提,不代表系统已授予/续持)
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "NovelPolishWorkAbility",
        "srcEntry": "./ets/works/NovelPolishWorkAbility.ets",
        "type": "workScheduler"
      }
    ],
    // Deep Read 需要的权限 + D-129 Agent 系统能力(对照 AndroidManifest uses-permission;
    //   仅普通 user_grant 档,受限 ACL(短信/通话/媒体库/电话状态)不声明 —
    //   checkAccessTokenSync 对未声明名返回拒绝,权限状态工具如实展示 Denied)
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET", "reason": "$string:reason_internet" },
      // 后台生成保活(C6-1;DATA_TRANSFER 长时任务,normal 档声明即授权)
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING", "reason": "$string:reason_internet" },
      { "name": "ohos.permission.GET_NETWORK_INFO", "reason": "$string:reason_network" },
      // 生成完成触觉反馈(D0-6;normal 档,声明即授权)
      { "name": "ohos.permission.VIBRATE", "reason": "$string:reason_vibrate" },
      // 自选工作区目录授权持久化(D2-1;若 debug profile 不含 ACL 将回退降级,见
      //   SettingSandboxPage 诚实注明)
      { "name": "ohos.permission.FILE_ACCESS_PERSIST", "reason": "$string:reason_file_persist" },
      // user_grant 权限(debug profile 需含 ACL;WRITE 系/定位/蓝牙随工具实装再解注释):
      // READ_CONTACTS 需 debug profile ACL 含该权限(当前 AGC 自动 profile 不含,
      // install 报 9568289);AGC 后台加 ACL 后解注释:
      // { "name": "ohos.permission.READ_CONTACTS", "reason": "$string:reason_contacts",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // { "name": "ohos.permission.WRITE_CONTACTS", "reason": "$string:reason_contacts",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.READ_CALENDAR", "reason": "$string:reason_calendar",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // READ_PASTEBOARD 属 ACL 管控:当前 AGC 调试 profile 不含该权限,
      //   声明会导致整包安装失败(9568289),故保持不声明并在权限页如实标注
      // HDR 提亮(uiEffect hdrBrightnessRatio,API 24+;normal 档,声明即授权)
      { "name": "ohos.permission.HDR_BRIGHTNESS", "reason": "$string:reason_hdr_brightness" },
      // { "name": "ohos.permission.WRITE_CALENDAR", "reason": "$string:reason_calendar",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // { "name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:reason_location",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // { "name": "ohos.permission.LOCATION", "reason": "$string:reason_location",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // { "name": "ohos.permission.ACCESS_BLUETOOTH", "reason": "$string:reason_bluetooth",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // { "name": "ohos.permission.ACTIVITY_MOTION", "reason": "$string:reason_activity_motion",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ]
  }
}
