@Component
export struct SubAgentAvatar {
  @StorageProp('themeEpoch') @Watch('drawSprite') themeEpoch: number = 0;
  @Prop @Watch('drawSprite') subagentId: string = '';
  @Prop @Watch('drawSprite') name: string = '';
  @Prop avatarSize: number = 20;
  @Prop status: string = '';
  private context: CanvasRenderingContext2D = new CanvasRenderingContext2D(new RenderingContextSettings(false));

  private sprite(): AgentSprite {
    const identity: string = this.subagentId.length > 0 ? this.subagentId : this.name;
    let hash: number = 0;
    for (let index: number = 0; index < identity.length; index++) {
      hash = (identity.charCodeAt(index) + ((hash << 5) - hash)) | 0;
    }
    return SPRITES[Math.abs(hash) % SPRITES.length];
  }

  private drawSprite(): void {
    const art: AgentSprite = this.sprite();
    const cell: number = this.avatarSize * 0.8 / 16;
    const inset: number = this.avatarSize * 0.1;
    this.context.clearRect(0, 0, this.avatarSize, this.avatarSize);
    for (let row: number = 0; row < 16; row++) {
      for (let col: number = 0; col < 16; col++) {
        const pixel: string = art.rows[row].charAt(col);
        if (pixel === '.') continue;
        this.context.fillStyle = pixel === '@' ? '#302D37'
          : (pixel === '#' ? art.body : (pixel === '+' ? art.accent : '#FFF4DC'));
        this.context.fillRect(inset + col * cell, inset + row * cell, cell, cell);
      }
    }
  }

  build(): void {
    Canvas(this.context)
      .width(this.avatarSize).height(this.avatarSize)
      .backgroundColor(SURFACE2).borderRadius(this.avatarSize * 0.24)
      .onReady((): void => { this.drawSprite(); })
      .onAreaChange((): void => { this.drawSprite(); })
      .accessibilityText(this.name)
  }
}
