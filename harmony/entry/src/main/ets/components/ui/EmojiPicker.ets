@Component
export struct EmojiPicker {
  @StorageProp('themeEpoch') themeEpoch: number = 0; // 主题重建订阅(勿删):epoch 递增即重读令牌
  @Prop iconSize: number = 36;
  onEmojiSelected: (emoji: string) => void = (_e: string): void => {};
  @State searchQuery: string = '';
  @State selectedCategory: number = 0;

  private filteredEmojis(): string[] {
    const cat: EmojiCategory = CATEGORIES[this.selectedCategory];
    if (this.searchQuery.trim().length === 0) return cat.emojis;
    // 简单过滤:搜索词匹配分类名或 emoji 本身
    const q: string = this.searchQuery.trim().toLowerCase();
    const all: string[] = CATEGORIES.flatMap((c: EmojiCategory): string[] => c.emojis);
    // emoji 无 name 数据 → 只按分类名过滤
    return cat.name.toLowerCase().includes(q) ? cat.emojis : [];
  }

  build(): void {
    Column() {
      // 搜索框
      TextInput({ text: this.searchQuery, placeholder: '搜索 emoji…' })
        .fontSize(BODY).fontColor(INK)
        .backgroundColor(SURFACE).borderRadius(999)
        .padding({ left: 14, right: 14, top: 8, bottom: 8 })
        .width('100%')
        .margin({ bottom: 8 })
        .onChange((v: string): void => { this.searchQuery = v; })

      // 分类 tab
      Scroll() {
        Row() {
          ForEach(CATEGORIES, (cat: EmojiCategory, i: number): void => {
            Text(cat.icon)
              .fontSize(BODY)
              .width(this.iconSize).height(this.iconSize)
              .textAlign(TextAlign.Center)
              .opacity(this.selectedCategory === i ? 1 : 0.4)
              .backgroundColor(this.selectedCategory === i ? SURFACE2 : 'transparent')
              .borderRadius(8)
              .margin({ right: 4 })
              .onClick((): void => { this.selectedCategory = i; })
          }, (cat: EmojiCategory, i: number): string => `${cat.name}-${i}`)
        }
        .padding({ bottom: 8 })
      }
      .scrollable(ScrollDirection.Horizontal)
      .scrollBar(BarState.Off)
      .width('100%')

      // emoji grid
      Grid() {
        ForEach(this.filteredEmojis(), (emoji: string, i: number): void => {
          GridItem() {
            Text(emoji)
              .fontSize(this.iconSize * 0.6)
              .width(this.iconSize).height(this.iconSize)
              .textAlign(TextAlign.Center)
              .onClick((): void => { this.onEmojiSelected(emoji); })
          }
        }, (emoji: string, i: number): string => `${emoji}-${i}`)
      }
      .columnsTemplate('1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr')
      .layoutWeight(1)
      .width('100%')
    }
      .opacity(this.themeEpoch >= 0 ? 1 : 1)
    .width('100%')
    .height('100%')
    .padding(12)
  }
}
