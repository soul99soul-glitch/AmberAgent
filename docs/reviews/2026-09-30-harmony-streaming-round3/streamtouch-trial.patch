@@ -0,0 +1,69 @@
+// Temporary, bounded same-process touch experiment. No global input injection.
+import { window } from '@kit.ArkUI';
+import { deviceInfo } from '@kit.BasicServicesKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { streamTouchProbeTap } from 'libamber_native.so';
+
+export class StreamTouchProbe {
+  private timer: number = -1;
+  private runId: string = '';
+  private blocked: boolean = false;
+  private ticks: number = 0;
+  private generation: number = 0;
+  private deadline: number = 0;
+  private globalX: number = -1;
+  private globalY: number = -1;
+  private mayPulse: () => boolean;
+  private getWindow: () => window.Window | null;
+
+  constructor(mayPulse: () => boolean, getWindow: () => window.Window | null) {
+    this.mayPulse = mayPulse;
+    this.getWindow = getWindow;
+  }
+
+  setTarget(globalX: number, globalY: number): void {
+    this.globalX = Math.round(globalX);
+    this.globalY = Math.round(globalY);
+  }
+
+  sync(runId: string, active: boolean): void {
+    if (!active) { this.stop(); return; }
+    if (!canIUse('SystemCapability.Window.SessionManager') ||
+      !canIUse('SystemCapability.MultimodalInput.Input.Core') || deviceInfo.sdkApiVersion < 20) return;
+    if (runId !== this.runId) {
+      this.stop();
+      this.runId = runId;
+      this.blocked = false;
+      this.ticks = 0;
+    }
+    if (runId.length === 0 || this.blocked || this.timer !== -1) return;
+    this.deadline = Date.now() + 30000;
+    const generation: number = this.generation;
+    this.timer = setInterval((): void => { this.pulse(generation); }, 2000);
+  }
+
+  block(): void { this.blocked = true; this.stop(); }
+
+  private stop(): void {
+    this.generation++;
+    if (this.timer !== -1) clearInterval(this.timer);
+    this.timer = -1;
+  }
+
+  private pulse(generation: number): void {
+    if (generation !== this.generation || this.blocked) return;
+    if (Date.now() >= this.deadline) { this.block(); return; }
+    this.ticks++;
+    if (!this.mayPulse() || this.globalX < 0 || this.globalY < 0) return;
+    const win: window.Window | null = this.getWindow();
+    if (win === null) return;
+    const props: window.WindowProperties = win.getWindowProperties();
+    const x: number = this.globalX - props.windowRect.left;
+    const y: number = this.globalY - props.windowRect.top;
+    if (x < 0 || y < 0 || x >= props.windowRect.width || y >= props.windowRect.height) return;
+    const result: number = streamTouchProbeTap(props.id, x, y, this.globalX, this.globalY);
+    hilog.info(0x0001, 'StreamTouchProbe', 'pulse=%{public}d result=%{public}d x=%{public}d y=%{public}d',
+      this.ticks, result, x, y);
+    if (result !== 0) this.block();
+  }
+}
--- harmony/chat/src/test/stream_touch_probe.test.cjs (baseline)
+++ harmony/chat/src/test/stream_touch_probe.test.cjs (trial)
@@ -0,0 +1,71 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const ts = require('typescript');
+
+function fixture(sdk = 26) {
+  const file = path.resolve(__dirname, '../../../entry/src/main/ets/components/StreamTouchProbe.ets');
+  const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS },
+  }).outputText;
+  const exports = {}, calls = [], timers = new Map();
+  let serial = 0, moving = true, now = 0;
+  vm.runInNewContext(code, { exports, require: name => {
+    if (name === '@kit.BasicServicesKit') return { deviceInfo: { sdkApiVersion: sdk } };
+    if (name === '@kit.PerformanceAnalysisKit') return { hilog: { info() {} } };
+    if (name === 'libamber_native.so') return { streamTouchProbeTap: (...args) => { calls.push(args); return 0; } };
+    return {};
+  }, canIUse: () => true, Math, Date: { now: () => now },
+  setInterval: (fn, ms) => { assert.equal(ms, 2000); timers.set(++serial, fn); return serial; },
+  clearInterval: id => timers.delete(id) });
+  const probe = new exports.StreamTouchProbe(() => moving, () => ({ getWindowProperties: () => ({
+    id: 42, windowRect: { left: 10, top: 20, width: 1000, height: 1800 },
+  }) }));
+  probe.setTarget(30, 60);
+  return { probe, calls, timers, moving: value => { moving = value; }, tick: (elapsed = 2000) => {
+    now += elapsed;
+    const callback = [...timers.values()][0]; assert.ok(callback); callback();
+  } };
+}
+
+test('pulses only while following, using measured same-window coordinates', () => {
+  const f = fixture(); f.probe.sync('run1', true); f.tick();
+  assert.deepEqual(f.calls, [[42, 20, 40, 30, 60]]);
+  f.moving(false); f.tick(); assert.equal(f.calls.length, 1);
+  f.probe.sync('run1', false); assert.equal(f.timers.size, 0);
+});
+
+test('real user interaction blocks the rest of this run; later snapshots cannot restart it', () => {
+  const f = fixture(); f.probe.sync('run1', true); f.tick(); f.probe.block();
+  f.probe.sync('run1', true); assert.equal(f.timers.size, 0);
+  f.probe.sync('run2', true); f.tick(); assert.equal(f.calls.length, 2);
+});
+
+test('a run is bounded to 30 seconds even if snapshots continue', () => {
+  const f = fixture(); f.probe.sync('run1', true);
+  for (let i = 0; i < 15; i++) f.tick();
+  assert.equal(f.calls.length, 14); assert.equal(f.timers.size, 0);
+  f.probe.sync('run1', true); assert.equal(f.timers.size, 0);
+});
+
+test('API12 and unmeasured targets never inject', () => {
+  const old = fixture(12); old.probe.sync('run1', true); assert.equal(old.timers.size, 0);
+  const f = fixture(); f.probe.setTarget(-1, -1); f.probe.sync('run1', true); f.tick();
+  assert.equal(f.calls.length, 0);
+});
+
+
+test('queued callbacks cannot inject after blocking or after a new run starts', () => {
+  const f = fixture(); f.probe.sync('run1', true);
+  const stale = [...f.timers.values()][0];
+  f.probe.block(); stale(); assert.equal(f.calls.length, 0);
+  f.probe.sync('run2', true); stale(); assert.equal(f.calls.length, 0);
+  f.tick(); assert.equal(f.calls.length, 1);
+});
+
+test('a delayed first callback past the deadline cannot inject', () => {
+  const f = fixture(); f.probe.sync('run1', true); f.tick(31000);
+  assert.equal(f.calls.length, 0); assert.equal(f.timers.size, 0);
+});
