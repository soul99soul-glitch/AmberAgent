@@ -0,0 +1,58 @@
+#include "stream_touch_probe.h"
+#include <multimodalinput/oh_input_manager.h>
+#include <chrono>
+#include <dlfcn.h>
+
+namespace {
+// Resolve the API20 entry only when called; the shared library must load on API12.
+using InjectTouch = int32_t (*)(int32_t, Input_TouchEvent *, int32_t, int32_t);
+
+napi_value Tap(napi_env env, napi_callback_info info)
+{
+    size_t argc = 5;
+    napi_value args[5] = {};
+    int32_t values[5] = {};
+    int32_t result = -2;
+    if (napi_get_cb_info(env, info, &argc, args, nullptr, nullptr) != napi_ok || argc != 5) {
+        napi_throw_type_error(env, nullptr, "streamTouchProbeTap requires five coordinates/IDs");
+        return nullptr;
+    }
+    for (size_t i = 0; i < 5; ++i) {
+        if (napi_get_value_int32(env, args[i], &values[i]) != napi_ok || values[i] < 0) {
+            napi_throw_type_error(env, nullptr, "streamTouchProbeTap requires nonnegative integers");
+            return nullptr;
+        }
+    }
+    static void *library = dlopen("libnative_window_manager.so", RTLD_NOW | RTLD_LOCAL);
+    static auto inject = library == nullptr ? nullptr :
+        reinterpret_cast<InjectTouch>(dlsym(library, "OH_WindowManager_InjectTouchEvent"));
+    if (inject == nullptr) {
+        result = -1;
+    } else if (auto *event = OH_Input_CreateTouchEvent()) {
+        OH_Input_SetTouchEventFingerId(event, 99);
+        OH_Input_SetTouchEventDisplayX(event, values[3]);
+        OH_Input_SetTouchEventDisplayY(event, values[4]);
+        const auto now = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        OH_Input_SetTouchEventActionTime(event, now);
+        OH_Input_SetTouchEventAction(event, 1); // DOWN, official Input_TouchEventAction
+        const int32_t down = inject(values[0], event, values[1], values[2]);
+        OH_Input_SetTouchEventActionTime(event, now + 1);
+        OH_Input_SetTouchEventAction(event, 3); // UP; always release the attempted contact.
+        const int32_t up = inject(values[0], event, values[1], values[2]);
+        result = down != 0 ? down : up;
+        OH_Input_DestroyTouchEvent(&event);
+    }
+    napi_value value = nullptr;
+    napi_create_int32(env, result, &value);
+    return value;
+}
+} // namespace
+
+napi_value RegisterStreamTouchProbe(napi_env env, napi_value exports)
+{
+    napi_property_descriptor descriptor = {
+        "streamTouchProbeTap", nullptr, Tap, nullptr, nullptr, nullptr, napi_default, nullptr
+    };
+    return napi_define_properties(env, exports, 1, &descriptor) == napi_ok ? exports : nullptr;
+}
