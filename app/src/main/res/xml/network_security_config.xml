<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Cleartext is required for the Synara LAN companion (and similar local tooling).
    Android network-security-config cannot express private-IP CIDR ranges as domains,
    so LAN HTTP to raw IPs must be allowed at base-config. The companion UI still
    validates that HTTP targets are private / Tailscale ranges before connecting.
  -->
  <base-config cleartextTrafficPermitted="true" />

  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
