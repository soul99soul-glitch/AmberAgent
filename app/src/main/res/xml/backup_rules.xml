<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
  <!-- 聊天记录等 Room 数据不进入 Google 云备份（应用自带加密同步通道） -->
  <include
    domain="sharedpref"
    path="." />
  <!-- 小程序 localStorage 是第三方写入的任意 KV（可能含 token），不进云备份 -->
  <exclude
    domain="sharedpref"
    path="mini_app_storage.xml" />
  <!-- 凭据与 OAuth 令牌存储绑定本地 Android Keystore，不进系统云备份 -->
  <exclude
    domain="sharedpref"
    path="amberagent_secret_store.xml" />
  <exclude
    domain="sharedpref"
    path="amberagent_oauth_tokens.xml" />
  <exclude
    domain="sharedpref"
    path="amberagent_webmount_oauth_pending.xml" />
  <exclude
    domain="sharedpref"
    path="amberagent_webmount_oauth_tokens.xml" />
  <exclude
    domain="sharedpref"
    path="amberagent_webmount_oauth_creds.xml" />
  <exclude
    domain="sharedpref"
    path="amberagent_webmount_profiles.xml" />
  <exclude
    domain="sharedpref"
    path="antigravity_oauth.xml" />
  <exclude
    domain="sharedpref"
    path="google_gemini_oauth.xml" />
  <exclude
    domain="sharedpref"
    path="grok_web_oauth.xml" />
  <exclude
    domain="sharedpref"
    path="grok_web_oauth_backup.xml" />
  <exclude
    domain="sharedpref"
    path="openai_codex_oauth.xml" />
  <include
    domain="file"
    path="upload/" />
  <include
    domain="file"
    path="amberagent/novel-workspace/" />
</full-backup-content>
